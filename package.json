{
  "name": "graphql-watchdog",
  "version": "0.1.0",
  "description": "GraphQL performance toolkit — N+1 detection, normalized caching, cost analysis, and CI regression testing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "bin": {
    "graphql-watchdog": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "graphql",
    "performance",
    "n+1",
    "dataloader",
    "cache",
    "cost-analysis",
    "monitoring",
    "graphql-yoga",
    "apollo",
    "redis",
    "cloudflare",
    "benchmark",
    "regression",
    "typescript"
  ],
  "author": "Mark Stuart",
  "license": "MIT",
  "homepage": "https://github.com/mstuart/graphql-watchdog#readme",
  "bugs": {
    "url": "https://github.com/mstuart/graphql-watchdog/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mstuart/graphql-watchdog.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "graphql-yoga": {
      "optional": true
    },
    "@apollo/server": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
