{
  "name": "graphql-watchdog",
  "version": "0.1.0",
  "description": "GraphQL performance toolkit — N+1 detection, normalized caching, cost analysis, and CI regression testing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "graphql-watchdog": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "graphql",
    "performance",
    "n+1",
    "dataloader",
    "cache",
    "cost-analysis",
    "monitoring"
  ],
  "author": "Mark Stuart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mstuart/graphql-watchdog.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "graphql": "^16.12.0"
  },
  "peerDependenciesMeta": {
    "@graphql-yoga/node": {
      "optional": true
    },
    "@apollo/server": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
